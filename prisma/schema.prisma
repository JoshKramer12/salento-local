generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum CategoryGroup {
  FOOD
  SERVICE
  SHOPPING
  TOURISM
  STAY
  BEACH
  ESSENTIAL
}

enum LocalityKind {
  LOCALITY
  MARINA
  FRAZIONE
  HAMLET
  VILLAGE
  SUBURB
  QUARTER
  NEIGHBOURHOOD
}

enum VerificationStatus {
  UNVERIFIED
  OPEN_DATA
  COMMUNITY_VERIFIED
  OWNER_VERIFIED
  REPORTED_STALE
}

enum ListingFeedbackType {
  REPORT_CLOSED
  SUGGEST_EDIT
  CLAIM_LISTING
}

enum ListingFeedbackStatus {
  NEW
  REVIEWED
  RESOLVED
  DISMISSED
}

enum SourceType {
  OPENSTREETMAP
  WIKIPEDIA
  WIKIDATA
  MUNICIPALITY
  OFFICIAL_WEBSITE
  TOURISM_PORTAL
  OPEN_DATA_PORTAL
  CHAMBER_OF_COMMERCE
  OTHER
}

enum SourceReuseStatus {
  ALLOWED
  LINK_ONLY
  SKIPPED
  UNKNOWN
}

enum UserRole {
  USER
  ADMIN
  GETTER
  BUSINESS_OWNER
}

enum SubmissionStatus {
  DRAFT
  AWAITING_VERIFICATION
  VERIFIED
  AWAITING_PAYMENT
  PAID
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  PENDING_REVIEW
  APPROVED
  READY_TO_PUBLISH
  PUBLISHED
  NEEDS_REVIEW
  REJECTED
}

enum PaymentMethod {
  ONLINE
  CASH
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING_PAYMENT
  AWAITING_BANK_TRANSFER
  PAID
  FAILED
  REFUNDED
}

enum PaymentRecordMethod {
  STRIPE_CHECKOUT
  BANK_TRANSFER
}

// A payment is kept against the original submission for receipt/access
// compatibility, while this field describes which membership term it bought.
enum PaymentPurpose {
  INITIAL_MEMBERSHIP
  ANNUAL_RENEWAL
  REACTIVATION
}

enum MembershipReminderType {
  AUTO_30_DAYS
  AUTO_7_DAYS
  MANUAL_30_DAYS
  MANUAL_14_DAYS
  MANUAL_7_DAYS
  GRACE_START
  GRACE_7_DAYS_LEFT
  EXPIRES_TOMORROW
  EXPIRED
}

enum VerificationChannel {
  EMAIL
  SMS
  WHATSAPP
  MANUAL
}

enum BusinessClaimStatus {
  REQUESTED
  AWAITING_VERIFICATION
  MANUAL_REVIEW
  VERIFIED
  APPROVED
  REJECTED
  EXPIRED
}

enum PartnerStripeAccountStatus {
  NOT_STARTED
  INCOMPLETE
  ACTION_REQUIRED
  READY
  RESTRICTED
}

enum PartnerPayoutMethod {
  STRIPE
  PAYPAL
  POSTEPAY
  HYPE
}

enum PartnerPayoutSetupStatus {
  NOT_SELECTED
  INCOMPLETE
  READY
  ACTION_REQUIRED
}

enum PartnerCommissionType {
  COMMISSION
  REVERSAL
  ADJUSTMENT
}

enum PartnerCommissionStatus {
  PENDING
  AVAILABLE
  RESERVED
  PAID
  REVERSED
  DEBT
}

enum PartnerPayoutRunStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum PartnerPayoutStatus {
  SCHEDULED
  PROCESSING
  PAID
  FAILED
  ACTION_REQUIRED
  CANCELED
}

enum PartnerWithdrawalStatus {
  REQUESTED
  PROCESSING
  PAID
  FAILED
  ACTION_REQUIRED
  CANCELED
}

enum StripeWebhookEndpointType {
  PLATFORM
  CONNECT
}

enum StripeWebhookProcessingStatus {
  PROCESSED
  SKIPPED
  FAILED
}

enum LegalDocumentType {
  BUSINESS_TERMS
  PARTNER_TERMS
  PRIVACY_POLICY
  COOKIE_POLICY
}

enum LegalAcceptanceContext {
  BUSINESS_SIGNUP
  PARTNER_SIGNUP
  BUSINESS_CLAIM
  BUSINESS_SUBMISSION
}

model Town {
  id               String     @id @default(cuid())
  slug             String     @unique
  name             String
  province         String
  region           String     @default("Puglia")
  shortDescription String
  intro            String
  history          String
  practicalInfo    String
  heroImageSeed    String
  imageUrl         String?
  latitude         Float
  longitude        Float
  population       Int?
  areaKm2          Float?
  elevationM       Int?
  wikipediaTitle   String?
  wikidataId       String?
  officialWebsite  String?
  sourceUrl        String?
  featured         Boolean    @default(false)
  aliases          TownAlias[]
  businesses       Business[]
  localities       Locality[]
  submissions      BusinessSubmission[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model TownAlias {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  note     String?
  townId   String
  town     Town   @relation(fields: [townId], references: [id], onDelete: Cascade)
}

model Category {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  icon        String
  description String
  group       CategoryGroup
  featured    Boolean       @default(false)
  businesses  Business[]
  submissions BusinessSubmission[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model User {
  id               String               @id @default(cuid())
  email            String?              @unique
  phone            String?              @unique
  username         String               @unique @default(cuid())
  name             String?
  passwordHash     String?
  image            String?
  role             UserRole             @default(USER)
  sessionVersion   Int                  @default(0)
  emailVerified    DateTime?
  profileCompleted Boolean              @default(false)
  accounts         Account[]
  sessions         Session[]
  passwordResetTokens PasswordResetToken[]
  submissions      BusinessSubmission[]
  claims           BusinessClaim[]
  ownedBusinesses  Business[]
  businessOwnerAccesses BusinessOwnerAccess[]
  payments         Payment[]            @relation("SubmissionPayer")
  partnerPayments  Payment[]            @relation("SubmissionPartner")
  partnerCommissions PartnerCommission[]
  originatingBusinessMemberships BusinessMembership[] @relation("OriginatingPartner")
  partnerPayouts   PartnerPayout[]
  partnerWithdrawals PartnerWithdrawalRequest[]
  localPartnerProfile LocalPartnerProfile?
  legalAcceptances LegalAcceptance[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([role, createdAt])
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

// Hashed, short-lived counters used for credential and public-write abuse
// protection. Keys intentionally do not retain raw IP addresses or account
// identifiers.
model SecurityRateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model Business {
  id               String          @id @default(cuid())
  slug             String          @unique
  sourceKey        String?         @unique
  externalSource   String?
  sourceUrl        String?
  name             String
  subcategory      String?
  shortDescription String
  description      String
  address          String
  addressPlaceId   String?
  addressStreetNumber String?
  addressRoute     String?
  addressLocality  String?
  addressProvince  String?
  addressRegion    String?
  addressPostalCode String?
  addressCountry   String?
  addressCountryCode String?
  phone            String?
  email            String?
  website          String?
  socialLinks      Json?
  openingHoursText String?
  rating           Float           @default(0)
  reviewCount      Int             @default(0)
  priceLevel       Int?
  isFeatured       Boolean         @default(false)
  isOpenNow        Boolean         @default(false)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  sourceConfidence Int             @default(0)
  lastVerifiedAt   DateTime?
  lastEnrichedAt   DateTime?
  isLikelyClosed   Boolean         @default(false)
  mapsUrl          String?
  heroImageSeed    String
  latitude         Float
  longitude        Float
  rawTags          Json?
  categoryId       String
  townId           String
  localityId       String?
  ownerUserId      String?
  category         Category        @relation(fields: [categoryId], references: [id])
  locality         Locality?       @relation(fields: [localityId], references: [id])
  ownerUser        User?           @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  town             Town            @relation(fields: [townId], references: [id])
  images           BusinessImage[]
  hours            BusinessHour[]
  reviews          Review[]
  feedback         ListingFeedback[]
  claims           BusinessClaim[]
  ownerAccesses    BusinessOwnerAccess[]
  payments         Payment[]
  partnerCommissions PartnerCommission[]
  sources          BusinessSource[]
  submissions      BusinessSubmission[]
  tags             BusinessTag[]
  membership       BusinessMembership?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([isLikelyClosed, townId, isFeatured, reviewCount, rating, name])
  @@index([isLikelyClosed, categoryId, isFeatured, reviewCount, rating, name])
  @@index([isLikelyClosed, localityId, isFeatured, reviewCount, rating, name])
  @@index([ownerUserId, updatedAt])
}

// A membership is scoped to one business page. It intentionally does not
// belong to an owner so one owner can hold different membership states across
// multiple businesses.
model BusinessMembership {
  id                       String   @id @default(cuid())
  businessId               String   @unique
  annualPriceCents         Int
  currentPeriodStart       DateTime
  currentPeriodEnd         DateTime
  graceEndsAt              DateTime
  automaticRenewal         Boolean  @default(false)
  originatingPartnerUserId String?
  stripeCustomerId         String?
  stripeSubscriptionId     String?
  stripeSubscriptionStatus String?
  stripeCancelAtPeriodEnd  Boolean  @default(false)
  recurringPaymentReady    Boolean  @default(false)
  entitlementRevokedAt     DateTime?
  business                 Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reminders                MembershipReminder[]
  paymentOutcomeDeliveries MembershipPaymentOutcomeDelivery[]
  failedPaymentDeliveries MembershipFailedPaymentDelivery[]
  originatingPartnerUser   User?    @relation("OriginatingPartner", fields: [originatingPartnerUserId], references: [id], onDelete: SetNull)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([originatingPartnerUserId])
  @@index([currentPeriodEnd, graceEndsAt])
}

model MembershipReminder {
  id           String                 @id @default(cuid())
  membershipId String
  // The exact entitlement boundary is the durable cycle key. This is not a
  // calendar year: memberships are always an exact 365-day term.
  cycleEndsAt  DateTime
  type         MembershipReminderType
  // sentAt is retained for historical rows. acceptedAt is the authoritative
  // provider-acceptance timestamp introduced with delivery tracking.
  sentAt       DateTime               @default(now())
  attemptedAt  DateTime?
  acceptedAt   DateTime?
  attemptCount Int                    @default(0)
  provider     String?
  providerMessageId String?
  failureMessage String?
  membership   BusinessMembership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, cycleEndsAt, type])
  @@index([membershipId, cycleEndsAt])
  @@index([sentAt])
  @@index([acceptedAt])
}

// Created only when a new renewal/reactivation payment is finalized. Historical
// paid rows are deliberately not backfilled into customer notifications.
model MembershipPaymentOutcomeDelivery {
  id                String   @id @default(cuid())
  paymentId         String   @unique
  membershipId      String
  periodEnd         DateTime
  businessName      String
  recipientEmail    String?
  locale            String?
  attemptedAt       DateTime?
  nextAttemptAt     DateTime @default(now())
  acceptedAt        DateTime?
  attemptCount      Int      @default(0)
  provider          String?
  providerMessageId String?
  failureMessage    String?
  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  membership        BusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([acceptedAt, nextAttemptAt])
  @@index([membershipId])
}

// Created only for a current failed Stripe invoice. Existing invoices are not
// backfilled, so a migration cannot schedule historical failure notices.
model MembershipFailedPaymentDelivery {
  id                String   @id @default(cuid())
  membershipId      String
  stripeInvoiceId   String   @unique
  stripeSubscriptionId String
  businessName      String
  graceEndsAt       DateTime
  recipientEmail    String?
  locale            String?
  attemptedAt       DateTime?
  nextAttemptAt     DateTime @default(now())
  acceptedAt        DateTime?
  canceledAt        DateTime?
  cancelReason      String?
  attemptCount      Int      @default(0)
  provider          String?
  providerMessageId String?
  failureMessage    String?
  membership        BusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([acceptedAt, canceledAt, nextAttemptAt])
  @@index([membershipId])
}

// A verified business-owner email is retained independently from the account
// that eventually signs in with it. This supports delayed activation, secure
// recovery, and more than one business per owner without making an invitation
// link the source of truth for access.
model BusinessOwnerAccess {
  id               String   @id @default(cuid())
  businessId       String
  email            String?
  phone            String?
  userId           String?
  sourceSubmissionId String? @unique
  verifiedAt       DateTime @default(now())
  activatedAt      DateTime?
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  invitations      BusinessOwnerAccessInvitation[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([businessId, email])
  @@unique([businessId, phone])
  @@unique([businessId, userId])
  @@index([email, userId])
  @@index([phone, userId])
}

model BusinessOwnerAccessInvitation {
  id                    String   @id @default(cuid())
  businessOwnerAccessId String
  tokenHash             String   @unique
  expiresAt             DateTime
  usedAt                DateTime?
  revokedAt             DateTime?
  businessOwnerAccess   BusinessOwnerAccess @relation(fields: [businessOwnerAccessId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())

  @@index([businessOwnerAccessId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Locality {
  id               String       @id @default(cuid())
  slug             String       @unique
  name             String
  shortDescription String
  intro            String
  practicalInfo    String
  heroImageSeed    String
  imageUrl         String?
  latitude         Float
  longitude        Float
  placeType        LocalityKind @default(LOCALITY)
  sourceUrl        String?
  featured         Boolean      @default(false)
  townId           String
  town             Town         @relation(fields: [townId], references: [id], onDelete: Cascade)
  businesses       Business[]
  submissions      BusinessSubmission[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model BusinessSubmission {
  id                 String            @id @default(cuid())
  userId             String
  status             SubmissionStatus  @default(DRAFT)
  businessName       String
  townId             String
  localityId         String?
  categoryId         String
  address            String
  addressPlaceId     String?
  addressLatitude    Float?
  addressLongitude   Float?
  addressStreetNumber String?
  addressRoute       String?
  addressLocality    String?
  addressProvince    String?
  addressRegion      String?
  addressPostalCode  String?
  addressCountry     String?
  addressCountryCode String?
  googleMapsUrl      String
  phone              String
  whatsapp           String
  email              String
  website            String?
  instagram          String?
  facebook           String?
  openingHours       String
  shortDescription   String
  longDescription    String
  ownerName          String
  ownerPhone         String
  ownerEmail         String
  ownerHasNoEmail    Boolean           @default(false)
  signerFullName     String?
  signerRole         String?
  signerRoleOther    String?
  agreementSignature String?
  signedAt           DateTime?
  businessTermsAcceptedAt DateTime?
  businessTermsVersion String?
  privacyPolicyVersionPresented String?
  firstYearPriceCentsAtAcceptance Int?
  renewalPriceCentsAtAcceptance Int?
  listingTermMonthsAtAcceptance Int?
  automaticRenewalAtAcceptance Boolean?
  contractualEmail   String?
  purchaseConfirmationSentAt DateTime?
  photoUrls          Json?
  paymentMethod      PaymentMethod?
  businessPriceCents Int               @default(10000)
  commissionCents    Int               @default(5000)
  platformShareCents Int               @default(5000)
  amountPaidCents    Int               @default(0)
  amountOwedCents    Int               @default(10000)
  paymentStatus      PaymentStatus     @default(NOT_REQUIRED)
  bankTransferReference String?
  createdBusinessId  String?
  verificationChannel VerificationChannel?
  verificationCodeHash String?
  verificationCodeExpiresAt DateTime?
  verificationAttempts Int            @default(0)
  verificationLastSentAt DateTime?
  verificationSentTo   String?
  verificationVerifiedAt DateTime?
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  town               Town              @relation(fields: [townId], references: [id])
  locality           Locality?         @relation(fields: [localityId], references: [id])
  category           Category          @relation(fields: [categoryId], references: [id])
  createdBusiness    Business?         @relation(fields: [createdBusinessId], references: [id])
  payments           Payment[]
  partnerCommissions PartnerCommission[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([userId, status])
  @@index([townId])
  @@index([categoryId])
  @@index([userId, createdAt])
  @@index([userId, updatedAt])
}

model Payment {
  id                     String              @id @default(cuid())
  businessSubmissionId   String
  businessId             String?
  userId                 String
  partnerUserId          String?
  amountCents            Int
  currency               String              @default("eur")
  method                 PaymentRecordMethod
  purpose                PaymentPurpose       @default(INITIAL_MEMBERSHIP)
  status                 PaymentStatus       @default(PENDING_PAYMENT)
  stripeCheckoutSessionId String?            @unique
  stripePaymentIntentId  String?
  stripeInvoiceId        String?             @unique
  stripeProductId        String?
  stripeCustomerId       String?
  stripeSubscriptionId   String?             @unique
  stripeSetupOperation   String?
  stripeSetupStartedAt   DateTime?
  stripeSetupGeneration  Int                 @default(0)
  stripeLastEventId      String?             @unique
  bankTransferReference  String?
  paidAt                 DateTime?
  refundInstructionsEmail String?
  refundRequestedAt      DateTime?
  refundRequestedByUserId String?
  refundRequestAmountCents Int?
  refundRequestLocale    String?
  bankRefundResolvedAt   DateTime?
  bankRefundResolvedByUserId String?
  bankRefundResolutionNote String?
  supportRefundRequestEmailClaimedAt DateTime?
  supportRefundRequestEmailSentAt DateTime?
  supportRefundRequestEmailError String?
  ownerRefundRequestEmailClaimedAt DateTime?
  ownerRefundRequestEmailSentAt DateTime?
  ownerRefundRequestEmailError String?
  partnerRefundRequestEmailClaimedAt DateTime?
  partnerRefundRequestEmailSentAt DateTime?
  partnerRefundRequestEmailError String?
  stripeRefundId         String?             @unique
  refundStatus           String?
  refundedAmountCents    Int?
  refundedAt             DateTime?
  selfServiceRefundedAt  DateTime?
  ownerRefundEmailSentAt DateTime?
  partnerRefundEmailSentAt DateTime?
  ownerRefundEmailClaimedAt DateTime?
  partnerRefundEmailClaimedAt DateTime?
  ownerRefundEmailError  String?
  partnerRefundEmailError String?
  business               Business?           @relation(fields: [businessId], references: [id], onDelete: SetNull)
  businessSubmission     BusinessSubmission  @relation(fields: [businessSubmissionId], references: [id], onDelete: Cascade)
  user                   User                @relation("SubmissionPayer", fields: [userId], references: [id], onDelete: Cascade)
  partnerUser            User?               @relation("SubmissionPartner", fields: [partnerUserId], references: [id], onDelete: SetNull)
  partnerCommissions     PartnerCommission[]
  partnerDisputes        PartnerPaymentDispute[]
  membershipPaymentOutcomeDelivery MembershipPaymentOutcomeDelivery?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([businessSubmissionId, createdAt])
  @@index([userId, createdAt])
  @@index([partnerUserId, createdAt])
  @@index([status, method])
}

model LocalPartnerProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  fullName              String
  legalFullName         String
  phone                 String
  whatsapp              String?
  baseTownOrArea        String
  preferredLanguage     String
  heardAbout            String?
  birthDate             DateTime?
  billingAddress        String
  taxIdOrVatNumber      String
  understandsNoCash     Boolean  @default(false)
  understandsNoPricing  Boolean  @default(false)
  understandsNoNegotiation Boolean @default(false)
  understandsDirectPayment Boolean @default(false)
  stripeConnectedAccountId String? @unique
  stripeOnboardingComplete Boolean @default(false)
  stripeDetailsSubmitted Boolean @default(false)
  stripePayoutsEnabled  Boolean @default(false)
  stripeChargesEnabled  Boolean @default(false)
  stripeRequirementsDue Json?
  stripeAccountStatus   PartnerStripeAccountStatus @default(NOT_STARTED)
  stripeDisabledReason  String?
  stripeOnboardingStartedAt DateTime?
  stripeOnboardingCompletedAt DateTime?
  stripeLastSyncedAt    DateTime?
  stripeCurrentDeadline DateTime?
  stripePayoutAccountLast4 String?
  stripePayoutBankName  String?
  preferredPayoutMethod PartnerPayoutMethod @default(STRIPE)
  payoutSetupStatus     PartnerPayoutSetupStatus @default(INCOMPLETE)
  payoutMethodUpdatedAt DateTime?
  paypalPayoutEmail     String?
  bankPayoutIbanEncrypted String?
  bankPayoutAccountLast4 String?
  bankPayoutAccountHolder String?
  partnerGuideCompleted Boolean  @default(false)
  partnerGuideVersion   Int      @default(0)
  partnerOnboardingCompletedAt DateTime?
  completedAt           DateTime?
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts               PartnerPayout[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model PartnerCommission {
  id                    String                 @id @default(cuid())
  partnerUserId         String
  businessSubmissionId  String?
  businessId            String?
  paymentId             String?
  payoutId              String?
  amountCents           Int
  currency              String                 @default("eur")
  type                  PartnerCommissionType
  status                PartnerCommissionStatus
  sourceKey             String                 @unique
  sourceEventType       String?
  sourceEventId         String?
  stripePaymentIntentId String?
  stripeCheckoutSessionId String?
  stripeChargeId        String?
  stripeTransferId      String?
  stripePayoutId        String?
  earnedAt              DateTime?
  eligibleAt            DateTime?
  transferredAt         DateTime?
  paidAt                DateTime?
  reversedAt            DateTime?
  reversalReason        String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  business              Business?              @relation(fields: [businessId], references: [id], onDelete: SetNull)
  businessSubmission    BusinessSubmission?    @relation(fields: [businessSubmissionId], references: [id], onDelete: SetNull)
  partnerUser           User                   @relation(fields: [partnerUserId], references: [id], onDelete: Cascade)
  payment               Payment?               @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  payout                PartnerPayout?         @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([partnerUserId, status, eligibleAt])
  @@index([businessSubmissionId, type])
  @@index([stripePaymentIntentId])
  @@index([partnerUserId, createdAt])
}

// Provider-verified dispute state. A missing row is not evidence that a
// historical dispute was resolved; reconciliation reports legacy events.
model PartnerPaymentDispute {
  id               String   @id @default(cuid())
  paymentId        String
  stripeDisputeId  String   @unique
  stripeChargeId   String
  status           String
  holdActive       Boolean  @default(true)
  observedAt       DateTime @default(now())
  resolvedAt       DateTime?
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, holdActive])
}

model PartnerPayoutRun {
  id                    String                 @id @default(cuid())
  runKey                String                 @unique
  scheduledFor          DateTime
  status                PartnerPayoutRunStatus
  startedAt             DateTime               @default(now())
  completedAt           DateTime?
  summary               Json?
  lastError             String?
  payouts               PartnerPayout[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([scheduledFor, status])
}

model PartnerPayout {
  id                    String                 @id @default(cuid())
  payoutRunId           String
  partnerUserId         String
  localPartnerProfileId String?
  amountCents           Int
  currency              String                 @default("eur")
  status                PartnerPayoutStatus
  attemptCount          Int                    @default(0)
  initiatedAt           DateTime               @default(now())
  paidAt                DateTime?
  failedAt              DateTime?
  actionRequiredAt      DateTime?
  canceledAt            DateTime?
  failureMessage        String?
  stripeConnectedAccountId String?
  stripeTransferId      String?                @unique
  stripePayoutId        String?                @unique
  bankAccountLast4      String?
  bankName              String?
  payoutMethod          PartnerPayoutMethod @default(STRIPE)
  providerPayoutId      String?                @unique
  providerBatchId       String?
  providerReference     String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  localPartnerProfile   LocalPartnerProfile?   @relation(fields: [localPartnerProfileId], references: [id], onDelete: SetNull)
  partnerUser           User                   @relation(fields: [partnerUserId], references: [id], onDelete: Cascade)
  payoutRun             PartnerPayoutRun       @relation(fields: [payoutRunId], references: [id], onDelete: Cascade)
  commissions           PartnerCommission[]
  withdrawalRequest     PartnerWithdrawalRequest?

  @@index([partnerUserId, status, initiatedAt])
}

model PartnerWithdrawalRequest {
  id                           String @id @default(cuid())
  partnerUserId                String
  idempotencyKey               String
  payoutId                     String @unique
  amountCents                  Int
  payoutMethod                 PartnerPayoutMethod
  destinationSnapshotEncrypted String
  status                       PartnerWithdrawalStatus @default(REQUESTED)
  failureReason                String?
  dispatchStartedAt            DateTime?
  stripeTransferRecordedAt     DateTime?
  payoutDispatchStartedAt      DateTime?
  manualTransferInitiatedAt    DateTime?
  manualTransferReference      String?
  manualBankName               String?
  manualInitiatedByUserId      String?
  settlementVerifiedAt         DateTime?
  settlementVerifiedByUserId   String?
  settlementEvidenceEncrypted String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  partnerUser                  User @relation(fields: [partnerUserId], references: [id], onDelete: Restrict)
  payout                       PartnerPayout @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  auditEvents                  PartnerWithdrawalAuditEvent[]
  manualBankReturn             PartnerManualBankReturn?

  @@unique([partnerUserId, idempotencyKey])
  @@index([partnerUserId, status, createdAt])
}

model PartnerWithdrawalAuditEvent {
  id                  String @id @default(cuid())
  withdrawalRequestId String
  fromStatus          PartnerWithdrawalStatus?
  toStatus            PartnerWithdrawalStatus
  reason              String?
  actorUserId         String?
  provider            String?
  providerReference   String?
  evidenceEncrypted   String?
  createdAt           DateTime @default(now())
  withdrawalRequest   PartnerWithdrawalRequest @relation(fields: [withdrawalRequestId], references: [id], onDelete: Restrict)

  @@index([withdrawalRequestId, createdAt])
}

/** A bank return is a new event after settlement, never a rewrite of PAID. */
model PartnerManualBankReturn {
  id                     String   @id @default(cuid())
  withdrawalRequestId    String   @unique
  bankReturnReference    String   @unique
  amountCents            Int
  evidenceEncrypted      String
  verifiedByUserId       String
  verifiedAt             DateTime @default(now())
  withdrawalRequest      PartnerWithdrawalRequest @relation(fields: [withdrawalRequestId], references: [id], onDelete: Restrict)
}

model StripeWebhookEvent {
  id                    String                       @id @default(cuid())
  stripeEventId         String                       @unique
  endpointType          StripeWebhookEndpointType
  eventType             String
  stripeObjectId        String?
  stripeAccountId       String?
  livemode              Boolean                      @default(false)
  status                StripeWebhookProcessingStatus
  errorMessage          String?
  summary               Json?
  processedAt           DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  @@index([endpointType, eventType, createdAt])
}

model BusinessClaim {
  id                      String              @id @default(cuid())
  businessId              String
  userId                  String
  status                  BusinessClaimStatus @default(REQUESTED)
  claimantName            String
  claimantPosition        String
  claimantEmail           String?
  claimantPhone           String?
  claimantWhatsapp        String?
  message                 String?
  verificationChannel     VerificationChannel?
  businessContactEmail    String?
  businessContactWhatsapp String?
  verificationCodeHash    String?
  verificationCodeExpiresAt DateTime?
  verificationAttempts    Int                 @default(0)
  verificationLastSentAt  DateTime?
  verificationSentTo      String?
  resendCount             Int                 @default(0)
  resendAvailableAt       DateTime?
  verifiedAt              DateTime?
  reviewedAt              DateTime?
  business                Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([businessId, status])
  @@index([userId, status])
}

model LegalAcceptance {
  id                String                 @id @default(cuid())
  userId            String
  documentType      LegalDocumentType
  documentVersion   String
  locale            String
  acceptanceContext LegalAcceptanceContext
  contextRef        String                 @default("")
  acceptedAt        DateTime               @default(now())
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType, documentVersion, acceptanceContext, contextRef])
  @@index([userId, documentType, acceptedAt])
}

model BusinessImage {
  id         String   @id @default(cuid())
  businessId String
  url        String
  alt        String
  sortOrder  Int      @default(0)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, sortOrder])
}

model BusinessHour {
  id         String   @id @default(cuid())
  businessId String
  dayOfWeek  Int
  startTime  String?
  endTime    String?
  closed     Boolean  @default(false)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
}

model Review {
  id         String   @id @default(cuid())
  businessId String
  authorName String
  title      String
  body       String
  rating     Float
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

model ListingFeedback {
  id          String                @id @default(cuid())
  businessId  String
  type        ListingFeedbackType
  status      ListingFeedbackStatus @default(NEW)
  senderName  String?
  senderEmail String?
  message     String
  business    Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model BusinessSource {
  id          String            @id @default(cuid())
  businessId  String
  sourceType  SourceType
  sourceName  String
  sourceUrl   String
  sourceKey   String?
  license     String?
  reuseStatus SourceReuseStatus @default(ALLOWED)
  confidence  Int               @default(0)
  isPrimary   Boolean           @default(false)
  fieldMask   Json?
  payload     Json?
  firstSeenAt DateTime          @default(now())
  lastSeenAt  DateTime          @default(now())
  lastCheckedAt DateTime        @default(now())
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@unique([businessId, sourceType, sourceUrl])
}

model Tag {
  id         String        @id @default(cuid())
  slug       String        @unique
  name       String
  businesses BusinessTag[]
}

model BusinessTag {
  businessId String
  tagId      String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([businessId, tagId])
}
